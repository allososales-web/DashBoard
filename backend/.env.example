# ─── Database ───
DATABASE_URL=postgresql://user:password@localhost:5432/store_ops

# ─── JWT ───
JWT_SECRET=your-jwt-secret-min-32-chars-long-random-string
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-random-string
JWT_EXPIRATION=15m

# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── CORS ───
CORS_ORIGIN=http://localhost:5173

# ─── 사내 호스트 서버 매출 Push API Key ───
# 사내 서버에서 POST /sales-data/push 호출 시 X-Api-Key 헤더에 이 값을 사용
# 충분히 긴 랜덤 문자열로 설정 (예: openssl rand -hex 32)
SALES_PUSH_API_KEY=your-secure-api-key-here
